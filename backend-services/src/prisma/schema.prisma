generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  SELLER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShippingStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  DELIVERED
  FAILED
}

// ==================== MODELS ====================

model User {
  id                      Int       @id @default(autoincrement())
  email                   String    @unique
  password                String
  name                    String
  phone                   String?
  role                    Role      @default(CUSTOMER)
  isActive                Boolean   @default(true)
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  resetToken              String?
  resetExpiry             DateTime?
  refreshToken            String?
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  seller          Seller?
  customerAddress Address[]
  orders          Order[]
  reviews         Review[]
  cart            Cart?
  wishlistItems   WishlistItem[]
  notifications   Notification[]
  adminLogs       AdminLog[]
  helpfulVotes    ReviewHelpful[]
  reviewReports   ReviewReport[]
  verifiedSellers Seller[]        @relation("AdminVerifiesSeller")

  @@map("users")
}

model Seller {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  storeName       String
  storePhone      String
  storeEmail      String?
  storeAddress    String
  storeLogo       String?
  storeBanner     String?
  description     String?
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  verifiedBy      Int?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        Product[]
  orders          Order[]
  verifiedByAdmin User?     @relation("AdminVerifiesSeller", fields: [verifiedBy], references: [id])

  @@map("sellers")
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String
  targetType String
  targetId   Int
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // Relations
  admin User @relation(fields: [adminId], references: [id])

  @@map("admin_logs")
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  nameTetum    String?
  description  String?
  image        String?
  banner       String?
  slug         String   @unique
  parentId     Int?
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  order        Int      @default(0)
  filterConfig Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  nameTetum        String?
  description      String
  descriptionTetum String?
  price            Float
  comparePrice     Float?
  cost             Float?
  stock            Int      @default(0)
  sku              String?
  barcode          String?
  videoUrl         String?
  images           Json     @default("[]")
  thumbnail        String?
  weight           Float?
  slug             String   @unique
  sellerId         Int
  categoryId       Int
  brand            String?
  specifications   Json     @default("{}")
  hasVariants      Boolean  @default(false)
  typeId           Int?
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  seller            Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category          Category          @relation(fields: [categoryId], references: [id])
  type              ProductType?      @relation(fields: [typeId], references: [id], onDelete: SetNull)
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  reviews           Review[]
  variants          ProductVariant[]
  productAttributes ProductAttribute[]
  videos            Video[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([slug])
  @@map("products")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  expiresAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model ProductVariant {
  id           Int      @id @default(autoincrement())
  productId    Int
  sku          String   @unique
  price        Float
  comparePrice Float?
  cost         Float?
  stock        Int      @default(0)
  images       Json     @default("[]")
  attributes   Json     @default("{}")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@map("product_variants")
}

model ProductType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  nameTetum   String?
  description String?
  slug        String   @unique
  fields      Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products Product[]

  @@map("product_types")
}

model ProductAttribute {
  id        Int    @id @default(autoincrement())
  productId Int
  key       String
  value     String

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([productId])
  @@map("product_attributes")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model Order {
  id                    Int           @id @default(autoincrement())
  orderNumber           String        @unique
  customerId            Int
  sellerId              Int
  subtotal              Float
  total                 Float?
  shippingCost          Float         @default(0)
  taxAmount             Float         @default(0)
  serviceFee            Float         @default(0)
  paymentMethod         PaymentMethod?
  status                OrderStatus   @default(PENDING)
  shippingMethod        String?
  courier               String?
  shippingStatus        ShippingStatus @default(PENDING)
  estimatedDeliveryDate DateTime?
  trackingNumber        String?
  notes                 String?
  addressId             Int
  shippingZoneId        Int?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  customer     User          @relation(fields: [customerId], references: [id])
  seller       Seller        @relation(fields: [sellerId], references: [id])
  items        OrderItem[]
  payment      Payment?
  address      Address       @relation(fields: [addressId], references: [id])
  shippingZone ShippingZone? @relation(fields: [shippingZoneId], references: [id])

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  total     Float
  createdAt DateTime @default(now())

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  proofImage    String?
  transactionId String?
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Country {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  provinces Province[]
  addresses Address[]

  @@map("countries")
}

model Province {
  id        Int       @id @default(autoincrement())
  countryId Int
  name      String
  code      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  country         Country          @relation(fields: [countryId], references: [id], onDelete: Cascade)
  municipalities  Municipality[]
  addresses       Address[]
  shippingZones   ShippingZone[]
  courierRates    CourierRate[]

  @@unique([countryId, name])
  @@map("provinces")
}

model Video {
  id           Int      @id @default(autoincrement())
  productId    Int?
  title        String
  description  String?  @db.Text
  videoUrl     String
  thumbnailUrl String?
  status       VideoStatus @default(PUBLISHED)
  views        Int      @default(0)
  likes        Int      @default(0)
  shares       Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("videos")
}

enum VideoStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Municipality {
  id          Int      @id @default(autoincrement())
  provinceId  Int
  name        String
  code        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  province      Province       @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  addresses     Address[]
  shippingZones ShippingZone[]
  courierRates  CourierRate[]

  @@unique([provinceId, name])
  @@map("municipalities")
}

model Address {
  id                  Int      @id @default(autoincrement())
  userId              Int
  label               String?
  countryId           Int?
  provinceId          Int
  municipalityId      Int
  province            String?
  municipality        String?
  administrativePost  String?
  suco                String
  village             String?
  street              String?
  postalCode          String?
  latitude            Float?
  longitude           Float?
  reference           String?
  phone               String?
  isPrimary           Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  country            Country?      @relation(fields: [countryId], references: [id])
  provinceRef        Province      @relation(fields: [provinceId], references: [id])
  municipalityRef    Municipality  @relation(fields: [municipalityId], references: [id])
  orders             Order[]

  @@index([userId])
  @@map("addresses")
}

model Courier {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  phone        String?
  website      String?
  trackingUrl  String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services     CourierService[]
  shippingZones ShippingZone[]
  courierRates CourierRate[]

  @@map("couriers")
}

model CourierService {
  id          Int      @id @default(autoincrement())
  courierId   Int
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courier     Courier       @relation(fields: [courierId], references: [id], onDelete: Cascade)
  courierRates CourierRate[]
  shippingZones ShippingZone[]

  @@unique([courierId, name])
  @@map("courier_services")
}

model CourierRate {
  id                Int      @id @default(autoincrement())
  courierId         Int
  courierServiceId  Int
  provinceId        Int?
  municipalityId    Int?
  price             Float
  etaDays           Int?
  minimumWeight     Float?
  maximumWeight     Float?
  status            String   @default("ACTIVE")
  priority          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  courier          Courier        @relation(fields: [courierId], references: [id], onDelete: Cascade)
  courierService   CourierService @relation(fields: [courierServiceId], references: [id], onDelete: Cascade)
  province         Province?      @relation(fields: [provinceId], references: [id])
  municipality     Municipality?  @relation(fields: [municipalityId], references: [id])
  shippingZones    ShippingZone[]

  @@map("courier_rates")
}

model ShippingZone {
  id                    Int      @id @default(autoincrement())
  zoneName              String
  provinceId            Int?
  municipalityId        Int?
  courierId             Int?
  courierServiceId      Int?
  courierRateId         Int?
  shippingMethod        String?
  shippingCost          Float
  estimatedDeliveryDays Int?
  minimumWeight         Float?
  maximumWeight         Float?
  status                String   @default("ACTIVE")
  priority              Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  provinceRef           Province?       @relation(fields: [provinceId], references: [id])
  municipalityRef       Municipality?   @relation(fields: [municipalityId], references: [id])
  courier               Courier?        @relation(fields: [courierId], references: [id])
  courierService        CourierService? @relation(fields: [courierServiceId], references: [id])
  courierRate           CourierRate?    @relation(fields: [courierRateId], references: [id])
  orders                Order[]

  @@map("shipping_zones")
}

model ShippingSetting {
  id                     Int      @id @default(autoincrement())
  defaultShippingCost    Float    @default(2.5)
  freeShippingThreshold  Float    @default(50)
  enableFreeShipping     Boolean  @default(false)
  enableDynamicShipping  Boolean  @default(false)
  enableLocalPickup      Boolean  @default(false)
  defaultCourier         String?
  defaultShippingMethod  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("shipping_settings")
}

model Review {
  id              Int       @id @default(autoincrement())
  productId       Int
  userId          Int
  rating          Int
  title           String?
  comment         String
  images          Json      @default("[]")
  isApproved      Boolean   @default(false)
  helpfulCount    Int       @default(0)
  sellerReply     String?
  sellerReplyAt   DateTime?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id])
  helpfulVotes  ReviewHelpful[]
  reviewReports ReviewReport[]

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model ReviewHelpful {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  userId    Int
  createdAt DateTime @default(now())

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
  @@map("review_helpful")
}

model ReviewReport {
  id         Int       @id @default(autoincrement())
  reviewId   Int
  userId     Int
  reason     String
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy Int?

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@map("review_reports")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean   @default(false)
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
