generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; linux-musl-openssl-3.0.x is the Alpine
  // Docker runtime (the build stage's OpenSSL-less "linux-musl" target
  // doesn't match the runner stage, which has OpenSSL 3.0.x installed).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  SELLER
  CUSTOMER
  COURIER
}

// Domain grouping for Notification.category — lets the admin panel filter
// ("Orders", "Payments", ...) without parsing the free-form `type` string.
enum NotificationCategory {
  ORDER
  PAYMENT
  SHIPPING
  SELLER
  PRODUCT
  CUSTOMER
  SYSTEM
  SECURITY
}

// Urgency, independent of category — drives icon/color and which events
// play a sound (see notification-priority docs in NotificationsService).
enum NotificationPriority {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShippingStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  DELIVERED
  FAILED
}

// How the user authenticates. GOOGLE accounts have no password — they sign
// in via Firebase, which already verifies the email, so User.password is
// nullable and emailVerified is set true at creation for that provider.
enum AuthProvider {
  EMAIL
  GOOGLE
}

// Product Types themselves stay admin-only to create/edit (a shared,
// platform-wide taxonomy would fragment into duplicates like "Ropa" /
// "Clothes" / "Pakaian" if every seller could create their own) — this is
// the middle ground: a seller proposes one, an admin reviews and either
// approves it (which creates the real ProductType) or rejects it.
enum ProductTypeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==================== MODELS ====================

model User {
  id                      Int          @id @default(autoincrement())
  email                   String       @unique
  password                String?
  name                    String
  phone                   String?
  role                    Role         @default(CUSTOMER)
  provider                AuthProvider @default(EMAIL)
  googleId                String?      @unique
  avatar                  String?
  isActive                Boolean      @default(true)
  emailVerified           Boolean      @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  resetToken              String?
  resetExpiry             DateTime?
  refreshToken            String?
  lastLoginAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  // Referral program — every user gets a code (generated at registration,
  // including Google sign-up), even one who never refers anyone.
  // referredById is set once, at registration, and never changes after —
  // see ReferralsService/AuthService.register's doc-comments for why a
  // dedicated "self-referral" check isn't needed here (structurally
  // impossible: the new user's id doesn't exist yet when the code is
  // looked up). walletCredit is the single source of truth for spendable
  // balance; every change to it MUST be paired with a WalletTransaction
  // row (see that model's doc-comment) — never mutate this field directly
  // outside ReferralsService.
  referralCode String  @unique
  referredById Int?
  walletCredit Float   @default(0)

  // Relations
  seller          Seller?
  customerAddress Address[]
  orders          Order[]
  reviews         Review[]
  cart            Cart?
  wishlistItems   WishlistItem[]
  notifications   Notification[]
  adminLogs       AdminLog[]
  helpfulVotes    ReviewHelpful[]
  reviewReports   ReviewReport[]
  verifiedSellers Seller[]        @relation("AdminVerifiesSeller")
  reviewedTypeRequests ProductTypeRequest[] @relation("AdminReviewsTypeRequest")
  videoLikes      VideoLike[]
  videoSaves      VideoSave[]
  videoComments   VideoComment[]
  sellerFollows   SellerFollow[]
  couponUsages    CouponUsage[]
  stockNotifications StockNotification[]
  assignedDeliveries Order[] @relation("OrderAssignedDriver")
  pushSubscriptions  PushSubscription[]
  referredBy         User?               @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers      User[]              @relation("UserReferrals")
  referralsGiven     Referral[]          @relation("ReferralReferrer")
  referralReceived   Referral?           @relation("ReferralReferredUser")
  walletTransactions WalletTransaction[]

  @@index([referredById])
  @@map("users")
}

model Seller {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  storeName       String
  storePhone      String
  storeEmail      String?
  storeAddress    String
  // Optional geocoding of storeAddress, captured from Google Places
  // Autocomplete when a seller picks a suggestion — entirely independent of
  // the Municipality table (which is Shipping/delivery-only, see
  // Municipality's own doc-comment). Never join against Municipality here;
  // a store's own address has no required relationship to the shipping
  // municipality system.
  storeLatitude   Float?
  storeLongitude  Float?
  storeLogo       String?
  storeBanner     String?
  description     String?
  // Seller's declared local origin (e.g. "this store's coffee comes from
  // Ermera") — distinct from storeAddress, which is just where the store
  // itself operates from. Plain text, never a Municipality FK: it must
  // stay independent of the Shipping Municipality system (see
  // storeLatitude's doc-comment above for the same reasoning). Used only
  // as the default a Product falls back to when its own originMode is
  // SELLER_ORIGIN — see Product.originMode. All four origin fields are
  // plain free text the seller enters directly (optionally assisted by a
  // Google Places search that best-effort fills them) — never a
  // Municipality/Posto/Suco/Aldeia FK, and never validated against
  // Shipping's location tables, so there is nothing to be "missing" from:
  // typing a value and saving is how a new one gets recorded.
  originMunicipality String?
  originPostoAdmin   String?
  originSuco         String?
  originAldeia       String?
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  verifiedBy      Int?
  rejectionReason String?
  // Payout destination. Optional — a seller can be verified and trading
  // before ever filling these in; PayoutsService requires them to be set
  // before a payout request can be created (see finance/payouts.service.ts).
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        Product[]
  orders          Order[]
  verifiedByAdmin User?     @relation("AdminVerifiesSeller", fields: [verifiedBy], references: [id])
  balance         SellerBalance?
  ledgerEntries   SellerLedgerEntry[]
  payouts         Payout[]
  followers       SellerFollow[]
  typeRequests    ProductTypeRequest[]
  promotions      Promotion[]

  @@map("sellers")
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String
  targetType String
  targetId   Int
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // Relations
  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@map("admin_logs")
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  nameTetum    String?
  description  String?
  image        String?
  banner       String?
  slug         String   @unique
  parentId     Int?
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  order        Int      @default(0)
  filterConfig Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

// See Product.originMode's doc-comment.
enum ProductOriginMode {
  SELLER_ORIGIN
  CUSTOM_ORIGIN
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  nameTetum        String?
  description      String   @db.Text
  descriptionTetum String?  @db.Text
  price            Float
  comparePrice     Float?
  cost             Float?
  stock            Int      @default(0)
  sku              String?
  barcode          String?
  videoUrl         String?
  images           Json     @default("[]")
  thumbnail        String?
  weight           Float?
  slug             String   @unique
  sellerId         Int
  categoryId       Int
  brand            String?
  specifications   Json     @default("{}")
  hasVariants      Boolean  @default(false)
  typeId           Int?
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  // Drives HomepageSectionRule.LOCAL — a real product attribute (seller-set,
  // independent of category) rather than the old category-based mechanism,
  // so a local product isn't invisible to "Local Products" merchandising
  // just because it happens to live in a non-"Local" category.
  isLocallyMade    Boolean  @default(false)
  // Only meaningful when isLocallyMade=true. SELLER_ORIGIN (default) means
  // "resolve from Seller.originMunicipality" — no municipality/posto/suco/
  // aldeia stored here, so a seller without a declared origin correctly
  // resolves to no origin rather than a fabricated one (see
  // ProductsService's resolveOrigin doc-comment). CUSTOM_ORIGIN means this
  // specific product's origin differs from the seller's (e.g. a reseller
  // in Dili carrying coffee actually grown in Bobonaro) and the
  // origin*/producer* fields below are the ones actually used.
  originMode        ProductOriginMode @default(SELLER_ORIGIN)
  // Only populated (and only read) when originMode=CUSTOM_ORIGIN. Plain
  // text — same reasoning as Seller.originMunicipality: never a
  // Municipality FK, never coupled to Shipping.
  originMunicipality String?
  originPostoAdmin   String?
  originSuco         String?
  originAldeia       String?
  // Optional, only shown in the UI when isLocallyMade=true. Deliberately
  // plain fields rather than a separate Producer model — no evidence yet
  // that a producer is ever shared across multiple products/sellers in a
  // way that would justify the extra normalization.
  producerName         String?
  producerOrganization String?
  producerPhone        String?
  length           Float?
  width            Float?
  height           Float?
  shippingClass    String?
  lowStockThreshold Int?
  metaTitle        String?  @db.VarChar(200)
  metaDescription  String?  @db.Text
  metaKeywords     Json     @default("[]")
  tags             Json     @default("[]")
  // Wholesale/packaging — purely informational (displayed to shoppers as
  // reference pricing) and product-level only, since a single packaging
  // config can't unambiguously apply across differently-priced variants.
  // Not read anywhere in the cart/checkout/stock-deduction path.
  wholesalePrice     Float?
  wholesaleMinQty    Int?
  packagingName      String?
  packagingUnitCount Int?
  packagingPrice     Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  seller            Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category          Category           @relation(fields: [categoryId], references: [id])
  type              ProductType?       @relation(fields: [typeId], references: [id], onDelete: SetNull)
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  reviews           Review[]
  variants          ProductVariant[]
  productAttributes ProductAttribute[]
  videos            Video[]
  homepageSectionEntries HomepageSectionProduct[]
  stockNotifications StockNotification[]
  promotionItems    PromotionItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([slug])
  @@map("products")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  expiresAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Set by AbandonedCartJob after it emails a reminder. Compared against
  // the cart's actual last-activity (max CartItem.updatedAt, not this row's
  // own updatedAt — item mutations never touch the parent Cart row) so a
  // customer who returns and changes their cart becomes eligible for one
  // more reminder after another period of inactivity.
  reminderSentAt DateTime?

  // Relations
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model ProductVariant {
  id           Int      @id @default(autoincrement())
  productId    Int
  sku          String   @unique
  price        Float
  comparePrice Float?
  cost         Float?
  stock        Int      @default(0)
  images       Json     @default("[]")
  attributes   Json     @default("{}")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  promotionItems PromotionItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  nameTetum   String?
  description String?
  slug        String   @unique
  fields      Json     @default("{}")
  // Suggested general specification fields for this type (e.g. Electronics
  // -> Voltage/Warranty, Fashion -> Material/Care Instructions) — distinct
  // from `fields`, which drives variant option pickers (Color/Size) on the
  // storefront, not the specification list. Same {name: "select"} shape as
  // `fields` for consistency; purely advisory, never enforced server-side.
  specFields  Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products Product[]
  requestsApprovedInto ProductTypeRequest[]

  @@map("product_types")
}

// A seller's proposal for a new Product Type, reviewed by an admin. Kept as
// its own table (not written straight into ProductType) so a seller can
// never create/mutate the shared taxonomy directly — see
// ProductTypeRequestStatus's doc-comment for why that boundary matters.
model ProductTypeRequest {
  id              Int      @id @default(autoincrement())
  sellerId        Int
  name            String
  nameTetum       String?
  description     String?
  // Same `{ fieldName: "select" }` shape as ProductType.fields/specFields —
  // carried over as-is into the real ProductType on approval.
  fields          Json     @default("{}")
  specFields      Json     @default("{}")
  status          ProductTypeRequestStatus @default(PENDING)
  reviewedBy      Int?
  reviewedAt      DateTime?
  rejectionReason String?
  // Set only once APPROVED — points at the ProductType the approval
  // created, so the seller's request list can link straight to it.
  resultingTypeId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  seller          Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewedByAdmin User?        @relation("AdminReviewsTypeRequest", fields: [reviewedBy], references: [id])
  resultingType   ProductType? @relation(fields: [resultingTypeId], references: [id])

  @@index([sellerId])
  @@index([status])
  @@map("product_type_requests")
}

model ProductAttribute {
  id        Int    @id @default(autoincrement())
  productId Int
  key       String
  value     String

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([productId])
  @@map("product_attributes")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// A pending "notify me when back in stock" subscription. Rows are deleted
// once the alert fires (see StockNotificationsService.notifySubscribers) —
// there's no isActive/notifiedAt flag, so the unique constraint always
// means "one open subscription per user+product," and a customer can
// re-subscribe cleanly the next time the same product goes out of stock.
model StockNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("stock_notifications")
}

model Order {
  id                    Int            @id @default(autoincrement())
  orderNumber           String         @unique
  customerId            Int
  sellerId              Int
  subtotal              Float
  total                 Float?
  shippingCost          Float          @default(0)
  taxAmount             Float          @default(0)
  serviceFee            Float          @default(0)
  // This order's proportional share of a cart-wide coupon discount (see
  // CouponUsage) — a coupon applied at checkout is split across every
  // seller's order in that checkout in proportion to each seller's share
  // of the cart subtotal, since each seller gets its own Order row.
  discountAmount        Float          @default(0)
  couponUsageId         Int?
  // Referral wallet credit applied to THIS order (post-tax, post-coupon —
  // see ReferralsService.debitWalletForCheckout's doc-comment for why
  // it's subtracted last rather than folded into discountAmount). Split
  // proportionally across a multi-seller checkout's Order rows the same
  // way discountAmount already is.
  walletCreditUsed      Float          @default(0)
  // Commission snapshot — written once, by FinanceService, at the moment
  // this order's Payment is confirmed PAID. Deliberately NOT computed live
  // from SystemSettings.defaultCommissionRate: if the admin changes the
  // rate tomorrow, orders paid today must keep the rate they were actually
  // charged under (see schema doc-comment on SystemSettings.defaultCommissionRate).
  // Null until payment is confirmed.
  commissionRate        Float?
  commissionAmount      Float?
  sellerNetAmount       Float?
  paymentMethod         PaymentMethod?
  status                OrderStatus    @default(PENDING)
  shippingMethod        String?
  courier               String?
  shippingStatus        ShippingStatus @default(PENDING)
  estimatedDeliveryDate DateTime?
  trackingNumber        String?
  notes                 String?
  addressId             Int
  shippingZoneId        Int?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Delivery snapshot — copied once from the selected Address at order
  // creation (see OrdersService.create), never re-read from `address` after
  // that. Deliberately NOT derived live from the `address` relation below:
  // that FK stays intact for lookups, but if the customer edits or deletes
  // that Address later, an already-placed order must keep showing what was
  // actually true when it was placed. deliveryLatitude/deliveryLongitude
  // may come from a checkout-only map pin instead of the Address's own
  // lat/lng (see CreateOrderDto) — that pin is scoped to this order only
  // and is never written back to the Address.
  deliveryRecipientName String?
  deliveryPhone         String?
  deliveryMunicipality  String?
  deliveryPostoAdmin    String?
  deliverySuco          String?
  deliveryVillage       String?
  deliveryStreet        String?
  deliveryReference     String?
  deliveryLatitude      Float?
  deliveryLongitude     Float?

  // Live courier position — the opposite of the delivery snapshot above:
  // deliberately mutable, most-recent-write-wins. Updated either by the
  // assigned driver's own device (see OrdersController's courier-location
  // endpoint) or by an external courier webhook. Never used for shipping
  // calculation or as historical record; it's purely "where is my delivery
  // right now" for the customer/admin to watch live.
  assignedDriverId         Int?
  courierLatitude          Float?
  courierLongitude         Float?
  courierLocationUpdatedAt DateTime?

  // When the driver (or an external courier webhook) marked shippingStatus
  // DELIVERED — distinct from `deliveredAt`, which only fires when the
  // financial `status` itself becomes DELIVERED (customer confirmation or
  // staff override). A driver marking a physical drop-off doesn't release
  // COD funds or seller earnings by itself (see OrdersService.
  // updateShippingStatus's doc-comment); this timestamp is what
  // DeliveryAutoConfirmJob measures the grace period against.
  driverDeliveredAt DateTime?

  // Relations
  customer      User          @relation(fields: [customerId], references: [id])
  seller        Seller        @relation(fields: [sellerId], references: [id])
  items         OrderItem[]
  payment       Payment?
  address       Address       @relation(fields: [addressId], references: [id])
  shippingZone  ShippingZone? @relation(fields: [shippingZoneId], references: [id])
  refunds       Refund[]
  ledgerEntries SellerLedgerEntry[]
  platformLedgerEntries PlatformLedgerEntry[]
  couponUsage   CouponUsage?  @relation(fields: [couponUsageId], references: [id])
  assignedDriver User?        @relation("OrderAssignedDriver", fields: [assignedDriverId], references: [id])
  referralQualifications Referral[]

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([orderNumber])
  @@index([addressId])
  @@index([shippingZoneId])
  @@index([couponUsageId])
  @@index([assignedDriverId])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  variantId Int?
  quantity  Int
  price     Float
  total     Float
  // Snapshot of the unit price *before* any promotion discount, captured
  // once at order creation — only set when a Promotion was actually applied
  // (null otherwise, meaning `price` already is the "normal" price). Kept
  // immutable and independent of Promotion so a seller editing/deleting the
  // promotion later never retroactively changes what a historical order
  // shows or owes. promotionId is informational/traceability only — pricing
  // never re-reads it.
  originalPrice Float?
  promotionId   Int?
  createdAt DateTime @default(now())

  // Relations
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  // Explicit Restrict (Prisma's default for an optional relation is
  // SetNull, not Restrict) — this blocks hard-deleting a variant that any
  // historical order line still references. Deactivate (isActive: false)
  // instead; see ProductsService.deleteVariant, which also enforces this
  // at the application layer with a clear error message before the DB
  // constraint would ever be hit.
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  promotion Promotion?      @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([promotionId])
  @@map("order_items")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Platform-wide discount codes (not per-seller vouchers — a coupon applies
// across a whole checkout, then OrdersService splits its discount
// proportionally across each seller's Order row for that checkout).
model Coupon {
  id                Int                @id @default(autoincrement())
  code              String             @unique
  description       String?
  discountType      CouponDiscountType
  discountValue     Float
  // Caps a PERCENTAGE discount's dollar value (e.g. "20% off, up to $10").
  // Not meaningful for FIXED_AMOUNT, where discountValue is already the cap.
  maxDiscountAmount Float?
  minPurchaseAmount Float?
  // Total redemptions allowed across every customer, enforced with an
  // atomic conditional update (see CouponsService.recordUsage) — mirrors
  // the same race-safe pattern OrdersService already uses for stock.
  usageLimit        Int?
  usageLimitPerUser Int                @default(1)
  usedCount         Int                @default(0)
  isActive          Boolean            @default(true)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  usages CouponUsage[]

  @@index([isActive])
  @@map("coupons")
}

// One row per checkout that redeemed a coupon (not one per Order — a
// multi-seller checkout creates several Order rows that all reference the
// same CouponUsage, since the coupon was only entered once).
model CouponUsage {
  id             Int      @id @default(autoincrement())
  couponId       Int
  userId         Int
  discountAmount Float
  createdAt      DateTime @default(now())

  coupon Coupon  @relation(fields: [couponId], references: [id])
  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([couponId, userId])
  @@map("coupon_usages")
}

enum ReferralStatus {
  PENDING
  REWARDED
}

// One row per successful referral capture at registration — never created
// any other way, and `referredUserId` is unique, so a user can be referred
// at most once, ever. `status` is the idempotency gate for the referrer's
// reward: ReferralsService.rewardReferrerIfEligible flips it PENDING ->
// REWARDED exactly once via an atomic updateMany (same race-safe idiom
// CouponsService.recordUsage uses for usedCount), triggered by whichever
// of the referred user's orders reaches DELIVERED first — every later
// DELIVERED order for that same customer is then a no-op since status is
// no longer PENDING, so there's no separate "is this their first order"
// query anywhere.
model Referral {
  id             Int            @id @default(autoincrement())
  referrerId     Int
  referredUserId Int            @unique
  // Snapshot of the code as typed at signup, not a live read of the
  // referrer's current code (which could theoretically change later).
  referralCodeUsed String
  status            ReferralStatus @default(PENDING)
  // Snapshots of SystemSettings.referralWelcomeCredit/referralRewardAmount
  // at the moment each was actually granted — admin changing those later
  // must never rewrite what a past referral already paid out.
  welcomeCreditAmount Float
  rewardAmount        Float?
  qualifyingOrderId   Int?
  rewardedAt          DateTime?
  createdAt           DateTime  @default(now())

  referrer        User   @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referredUser    User   @relation("ReferralReferredUser", fields: [referredUserId], references: [id])
  qualifyingOrder Order? @relation(fields: [qualifyingOrderId], references: [id])

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

enum WalletTransactionType {
  REFERRAL_WELCOME
  REFERRAL_REWARD
  CHECKOUT_REDEMPTION
  ADMIN_ADJUSTMENT
}

// Append-only audit ledger — the only thing that's ever supposed to write
// User.walletCredit is ReferralsService, and every single write it makes
// is paired with one of these rows in the same transaction, so "why does
// this user have this balance" is always answerable without guessing.
// referralId/orderId are plain informational ints (not required relations)
// so a referral/order being referenced doesn't force this table into
// their delete/cascade semantics — same "traceability only" reasoning as
// OrderItem.promotionId elsewhere in this schema.
model WalletTransaction {
  id           Int                   @id @default(autoincrement())
  userId       Int
  type         WalletTransactionType
  // Positive = credit, negative = debit.
  amount       Float
  balanceAfter Float
  referralId   Int?
  orderId      Int?
  note         String?
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("wallet_transactions")
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Seller-owned, product-scoped, time-bound marketing discount — distinct
// from Coupon (platform-wide, admin-only, cart/code-based, no product
// scoping — see Coupon's doc-comment). A Promotion never touches
// Product.price/ProductVariant.price; it's a read-time overlay resolved by
// PromotionsService.getEffectivePrice/attachPricing, the single trusted
// calculation path every surface (product list/detail, seller store, cart,
// checkout) goes through. Status (Scheduled/Active/Expired/Deactivated) is
// always derived at read time from isActive + startAt/endAt vs now — same
// pattern as Coupon, no cron job flips anything.
model Promotion {
  id            Int                   @id @default(autoincrement())
  sellerId      Int
  name          String
  description   String?
  discountType  PromotionDiscountType
  discountValue Float
  startAt       DateTime
  endAt         DateTime
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Relations
  seller Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  items  PromotionItem[]
  orderItems OrderItem[]

  @@index([sellerId])
  @@index([isActive, startAt, endAt])
  @@map("promotions")
}

// One row per product (or, optionally, a single variant) included in a
// Promotion. variantId is nullable and v1's seller UI never sets it — a
// promotion targets whole products, discounting every one of that
// product's own price/each variant's own price uniformly. The column exists
// so a future variant-level promotion doesn't require a schema change.
model PromotionItem {
  id          Int      @id @default(autoincrement())
  promotionId Int
  productId   Int
  variantId   Int?
  createdAt   DateTime @default(now())

  // Relations
  promotion Promotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("promotion_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  proofImage    String?
  transactionId String?
  notes         String?
  paidAt        DateTime?
  // Bank-transfer only — set at creation to now + SystemSettings.paymentExpiryHours.
  // A PaymentExpiryJob sweeps PENDING transfers with no proofImage past this
  // and expires them (see payments/payment-expiry.job.ts). A receipt already
  // uploaded and awaiting admin review is never auto-expired, even if this
  // timestamp has passed — only an abandoned payment is.
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@map("payments")
}

// ============================================================================
// Seller Finance — Commission, Balance, Ledger, Payout, Refund
// ============================================================================
// One Order always belongs to exactly one Seller (see Order.sellerId) —
// multi-seller carts are split into one Order per seller at checkout
// (OrdersService.create). That means there is no cross-seller allocation
// problem to solve here: an order's commission/net figures apply to that
// order's single seller directly. FinanceService is the only writer of
// SellerBalance/SellerLedgerEntry — never mutate those tables directly.

enum LedgerEntryType {
  SALE                 // + gross (order.subtotal) into pending, on payment confirmed
  COMMISSION           // - platform's cut, into pending, alongside SALE
  RELEASE              // pending -> available transfer, on order delivered
  REFUND               // - seller's net share, reverses SALE+COMMISSION (pending or available,
                        // whichever currently holds it — see FinanceService.reverseEarningsOnRefund)
  COMMISSION_REVERSAL  // documents the platform's commission being reversed proportionally on a
                        // refund (Refund.commissionReversed) — zero seller-balance-bucket deltas,
                        // since commission was never in SellerBalance to begin with (see REFUND);
                        // this entry exists purely so the ledger has a complete record of the event
  PAYOUT               // - available, on payout paid
  ADJUSTMENT           // manual admin correction, or a refund that exceeds what's
                        // left in pending+available (balance is allowed to go
                        // negative rather than block the refund — see RefundsService)
  RESYNC               // corrects a PRE-EXISTING gap between a stored SellerBalance bucket and
                        // what its own ledger already summed to (e.g. after an incident like
                        // SOP-13). Always written with delta=0 — an Adjustment's delta necessarily
                        // moves stored and ledger together, which can never close a gap that
                        // already exists between them; RESYNC sets stored directly to the
                        // ledger-implied value instead, and the zero-delta entry is purely a
                        // dated, attributed record of "this bucket was force-aligned here."
}

// One row per seller. Always derived by summing this seller's
// SellerLedgerEntry rows — FinanceService keeps it in sync transactionally
// on every write so reads don't need to re-aggregate the ledger.
model SellerBalance {
  id      Int @id @default(autoincrement())
  sellerId Int @unique
  pendingAmount Float @default(0)
  availableAmount Float @default(0)
  // Reserved out of availableAmount the moment a payout is created
  // (PayoutsService.createPayout) and moved into paidOutAmount when marked
  // paid, or back into availableAmount if rejected — always equal to the
  // sum of this seller's Payout rows currently in PENDING/APPROVED status.
  processingAmount Float @default(0)
  paidOutAmount Float @default(0)
  refundedAmount Float @default(0)
  updatedAt DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_balances")
}

// Append-only audit trail. Every SellerBalance change must be accompanied
// by a row here recording why — this is the source of truth for "why is
// the balance what it is" (financial reconciliation), not just a log.
model SellerLedgerEntry {
  id                    Int             @id @default(autoincrement())
  sellerId              Int
  orderId               Int?
  payoutId              Int?
  refundId              Int?
  type                   LedgerEntryType
  // One delta column per SellerBalance bucket. A pure transfer between two
  // buckets (RELEASE, PAYOUT reservation/completion) sets both the
  // outgoing and incoming column on the SAME row — summing all deltas on a
  // transfer row nets to zero by design, which is exactly why nothing may
  // ever collapse them into a single "delta" number for display; each
  // bucket's movement must be read (and shown) independently.
  pendingDelta           Float           @default(0)
  availableDelta         Float           @default(0)
  processingDelta        Float           @default(0)
  paidOutDelta           Float           @default(0)
  refundedDelta          Float           @default(0)
  pendingBalanceAfter    Float
  availableBalanceAfter  Float
  processingBalanceAfter Float           @default(0)
  paidOutBalanceAfter    Float           @default(0)
  refundedBalanceAfter   Float           @default(0)
  note                   String?
  createdAt              DateTime        @default(now())

  seller Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // Restrict, not the Prisma default SetNull — an order with ledger history
  // must be un-deletable by ANY means, not just through OrdersService's own
  // application-level guard. See the migration note for why this matters.
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payout Payout? @relation(fields: [payoutId], references: [id])
  refund Refund? @relation(fields: [refundId], references: [id])

  @@index([sellerId])
  @@index([orderId])
  @@map("seller_ledger_entries")
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Payout {
  id                Int          @id @default(autoincrement())
  sellerId          Int
  amount            Float
  status            PayoutStatus @default(PENDING)
  // Snapshotted from Seller.bank* at request time — a seller changing their
  // bank details later must not silently redirect a payout already in flight.
  bankName          String
  bankAccountName   String
  bankAccountNumber String
  requestedAt       DateTime     @default(now())
  processedAt       DateTime?
  processedBy       Int?
  adminNote         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  seller        Seller              @relation(fields: [sellerId], references: [id])
  ledgerEntries SellerLedgerEntry[]

  @@index([sellerId])
  @@map("payouts")
}

enum RefundType {
  FULL
  PARTIAL
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

model Refund {
  id          Int          @id @default(autoincrement())
  paymentId   Int
  orderId     Int
  amount      Float
  // Proportional slice of Order.commissionAmount reversed alongside the
  // seller's net share — set once, at approval time, by the same
  // proportion FinanceService already uses for the seller side. 0 until
  // approved. This is what makes Finance Overview's "Platform Net Revenue"
  // a real number instead of a query-time estimate.
  commissionReversed Float @default(0)
  reason      String
  type        RefundType
  status      RefundStatus @default(PENDING)
  requestedBy Int
  requestedAt DateTime     @default(now())
  processedBy Int?
  processedAt DateTime?
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payment       Payment             @relation(fields: [paymentId], references: [id])
  order         Order               @relation(fields: [orderId], references: [id])
  ledgerEntries SellerLedgerEntry[]
  platformLedgerEntries PlatformLedgerEntry[]

  @@index([paymentId])
  @@index([orderId])
  @@map("refunds")
}

// ============================================================================
// Platform Finance — Commission Revenue, Shipping, Tax
// ============================================================================
// Mirrors the Seller Finance section above exactly: one maintained balance
// row + an append-only ledger explaining every change to it. Before this,
// Order.shippingCost and Order.taxAmount were collected from the customer
// (folded into Payment.amount) but never credited anywhere — not to the
// seller, not to any platform account — so the money had no tracked
// destination once payment was confirmed. This closes that gap using the
// same "one writer, ledger is the source of truth" pattern FinanceService
// already uses for sellers, rather than inventing a second architecture.
//
// "Held" buckets (shippingHeld, taxHeld) are money collected but not yet
// remitted — shipping is presumed owed to whichever courier fulfills the
// order, tax is owed to the tax authority. This app has no courier-invoicing
// or tax-filing integration, so remittance is a manual admin action
// (FinanceService.recordPlatformRemittance) that records money paid out,
// not an automated payout workflow.
enum PlatformLedgerType {
  COMMISSION          // + platform's commission revenue, on payment confirmed (mirrors seller COMMISSION)
  SHIPPING_COLLECTED  // + shipping fee collected from customer, on payment confirmed
  TAX_COLLECTED       // + tax collected from customer, on payment confirmed
  COMMISSION_REVERSAL // - proportional reversal on an approved refund
  SHIPPING_REVERSAL   // - proportional reversal on an approved refund
  TAX_REVERSAL        // - proportional reversal on an approved refund
  REMITTANCE          // - manual admin action: shipping paid out to a courier, or tax remitted to the authority
  ADJUSTMENT          // manual correction, mirrors SellerLedgerEntry ADJUSTMENT
  RESYNC              // reconciliation correction, mirrors SellerLedgerEntry RESYNC
}

// Singleton row (same "findFirst, create if missing" convention as
// SystemSettings) — there is exactly one platform, so no key column.
model PlatformBalance {
  id                Int      @id @default(autoincrement())
  commissionRevenue Float    @default(0)
  shippingHeld      Float    @default(0)
  shippingRemitted  Float    @default(0)
  taxHeld           Float    @default(0)
  taxRemitted       Float    @default(0)
  updatedAt         DateTime @updatedAt

  @@map("platform_balance")
}

model PlatformLedgerEntry {
  id                            Int                @id @default(autoincrement())
  orderId                       Int?
  refundId                      Int?
  type                          PlatformLedgerType
  commissionDelta               Float              @default(0)
  shippingHeldDelta             Float              @default(0)
  shippingRemittedDelta         Float              @default(0)
  taxHeldDelta                  Float              @default(0)
  taxRemittedDelta              Float              @default(0)
  commissionBalanceAfter        Float
  shippingHeldBalanceAfter      Float
  shippingRemittedBalanceAfter  Float              @default(0)
  taxHeldBalanceAfter           Float
  taxRemittedBalanceAfter       Float              @default(0)
  note                          String?
  createdAt                     DateTime           @default(now())

  // Restrict, not the Prisma default SetNull — same reasoning as
  // SellerLedgerEntry.order: an order with ledger history must stay
  // un-deletable through any path, not just an application-level guard.
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refund Refund? @relation(fields: [refundId], references: [id])

  @@index([orderId])
  @@map("platform_ledger_entries")
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provinces Province[]
  addresses Address[]

  @@map("countries")
}

model Province {
  id        Int      @id @default(autoincrement())
  countryId Int
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country        Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  municipalities Municipality[]
  addresses      Address[]
  shippingZones  ShippingZone[]
  courierRates   CourierRate[]

  @@unique([countryId, name])
  @@map("provinces")
}

model Video {
  id           Int             @id @default(autoincrement())
  productId    Int?
  title        String
  description  String?         @db.Text
  videoUrl     String
  thumbnailUrl String?
  // Cloudinary's own identifiers/metadata from the upload response —
  // previously discarded, keeping only secure_url. videoPublicId (and
  // thumbnailPublicId) are what let us actually delete the old asset from
  // Cloudinary when a video is replaced or removed, instead of leaking an
  // orphaned file on every re-upload; duration/width/height/format support
  // future delivery-URL optimization and player UI (e.g. showing runtime).
  // Nullable: rows created before this field existed have none of this,
  // and that's fine — every read path already treats these as optional.
  videoPublicId     String?
  thumbnailPublicId String?
  duration          Float?
  width             Int?
  height            Int?
  format            String?
  // The admin content pipeline: PENDING (uploaded, awaiting an explicit
  // publish decision), PUBLISHED (live in the customer feed), SCHEDULED
  // (will auto-publish at publishedAt — see VideoScheduleJob), REJECTED
  // (held back, not shown). Only PUBLISHED + visibility PUBLIC videos are
  // ever returned by the customer-facing feed/recommendations queries.
  status       VideoStatus     @default(PENDING)
  visibility   VideoVisibility @default(PUBLIC)
  // Per-video moderation/engagement toggles — checked by both the API
  // (like/comment/save mutations reject when the relevant toggle is off)
  // and the storefront (hides the corresponding action button entirely).
  allowComments  Boolean @default(true)
  allowLikes     Boolean @default(true)
  allowSharing   Boolean @default(true)
  allowSave      Boolean @default(true)
  enableShopping Boolean @default(true)
  // Set when status becomes PUBLISHED (immediately) or SCHEDULED (the
  // future publish time VideoScheduleJob watches for).
  publishedAt DateTime?
  views       Int       @default(0)
  likes       Int       @default(0)
  shares      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  product  Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  likedBy  VideoLike[]
  savedBy  VideoSave[]
  comments VideoComment[]

  @@index([productId])
  @@index([status])
  @@map("videos")
}

enum VideoStatus {
  PENDING
  PUBLISHED
  SCHEDULED
  REJECTED
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

// Per-user like on a Video — dedups via the unique constraint and backs the
// real "isLiked" state the video-shopping feed needs. Video.likes stays as
// a denormalized counter kept in sync alongside these rows (VideosService),
// so existing trending sort (`orderBy likes desc`) keeps working unchanged.
model VideoLike {
  id        Int      @id @default(autoincrement())
  videoId   Int
  userId    Int
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
  @@map("video_likes")
}

// Per-user "save/bookmark" on a Video.
model VideoSave {
  id        Int      @id @default(autoincrement())
  videoId   Int
  userId    Int
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
  @@map("video_saves")
}

// Comments on a Video, with one level of replies via parentId. `likes` is a
// simple anonymous counter — same idiom already used on Video (likes/views/
// shares) — rather than a second per-user join table, to keep this addition
// proportionate to what the redesign actually needs.
model VideoComment {
  id        Int      @id @default(autoincrement())
  videoId   Int
  userId    Int
  parentId  Int?
  content   String   @db.Text
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video   Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  VideoComment?  @relation("VideoCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies VideoComment[] @relation("VideoCommentReplies")

  @@index([videoId])
  @@index([parentId])
  @@map("video_comments")
}

// Per-user follow of a Seller/creator — backs the Follow button and
// follower count on the video-shopping creator header.
model SellerFollow {
  id        Int      @id @default(autoincrement())
  sellerId  Int
  userId    Int
  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@index([userId])
  @@map("seller_follows")
}

model Municipality {
  id         Int      @id @default(autoincrement())
  provinceId Int
  name       String
  code       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province      Province       @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  addresses     Address[]
  shippingZones ShippingZone[]
  courierRates  CourierRate[]

  @@unique([provinceId, name])
  @@map("municipalities")
}

model Address {
  id                 Int      @id @default(autoincrement())
  userId             Int
  label              String?
  countryId          Int?
  provinceId         Int
  municipalityId     Int
  province           String?
  municipality       String?
  postoAdmin         String?  @map("administrativePost")
  suco               String
  village            String?
  street             String?
  postalCode         String?
  latitude           Float?
  longitude          Float?
  reference          String?
  phone              String?
  // Who to hand the delivery to at this address — may not be the account
  // holder (gift, office where a colleague receives it, etc.). Address.phone
  // was already implicitly "the account owner's number"; this fills the
  // matching gap for the name a courier should ask for on arrival.
  recipientName      String?
  isPrimary          Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  country         Country?     @relation(fields: [countryId], references: [id])
  provinceRef     Province     @relation(fields: [provinceId], references: [id])
  municipalityRef Municipality @relation(fields: [municipalityId], references: [id])
  orders          Order[]

  @@index([userId])
  @@map("addresses")
}

model Courier {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  phone       String?
  website     String?
  trackingUrl String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services      CourierService[]
  shippingZones ShippingZone[]
  courierRates  CourierRate[]

  @@map("couriers")
}

model CourierService {
  id          Int      @id @default(autoincrement())
  courierId   Int
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courier       Courier        @relation(fields: [courierId], references: [id], onDelete: Cascade)
  courierRates  CourierRate[]
  shippingZones ShippingZone[]

  @@unique([courierId, name])
  @@map("courier_services")
}

model CourierRate {
  id               Int      @id @default(autoincrement())
  courierId        Int
  courierServiceId Int
  provinceId       Int?
  municipalityId   Int?
  price            Float
  etaDays          Int?
  minimumWeight    Float?
  maximumWeight    Float?
  status           String   @default("ACTIVE")
  priority         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courier        Courier        @relation(fields: [courierId], references: [id], onDelete: Cascade)
  courierService CourierService @relation(fields: [courierServiceId], references: [id], onDelete: Cascade)
  province       Province?      @relation(fields: [provinceId], references: [id])
  municipality   Municipality?  @relation(fields: [municipalityId], references: [id])
  shippingZones  ShippingZone[]

  @@index([courierId])
  @@index([courierServiceId])
  @@index([provinceId])
  @@index([municipalityId])
  @@map("courier_rates")
}

model ShippingZone {
  id                    Int      @id @default(autoincrement())
  zoneName              String
  provinceId            Int?
  municipalityId        Int?
  courierId             Int?
  courierServiceId      Int?
  courierRateId         Int?
  shippingMethod        String?
  shippingCost          Float
  estimatedDeliveryDays Int?
  minimumWeight         Float?
  maximumWeight         Float?
  status                String   @default("ACTIVE")
  priority              Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  provinceRef     Province?       @relation(fields: [provinceId], references: [id])
  // onDelete/onUpdate pinned to Restrict: courierId/municipalityId feed the
  // activeRateKey generated column (see the enforce_active_shipping_rate_uniqueness
  // migration), and MySQL rejects SetNull/Cascade foreign key actions on a
  // column referenced by a generated column expression (error 1215). Leaving
  // this as the Prisma default would make the next `migrate dev` try to
  // "correct" it back to SetNull and reintroduce that failure.
  municipalityRef Municipality?   @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  courier         Courier?        @relation(fields: [courierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  courierService  CourierService? @relation(fields: [courierServiceId], references: [id])
  courierRate     CourierRate?    @relation(fields: [courierRateId], references: [id])
  orders          Order[]

  @@index([provinceId])
  @@index([municipalityId])
  @@index([courierId])
  @@index([courierServiceId])
  @@index([courierRateId])
  @@map("shipping_zones")
}

model ShippingSetting {
  id                    Int      @id @default(autoincrement())
  defaultShippingCost   Float    @default(2.5)
  freeShippingThreshold Float    @default(50)
  enableFreeShipping    Boolean  @default(false)
  enableDynamicShipping Boolean  @default(false)
  enableLocalPickup     Boolean  @default(false)
  defaultCourier        String?
  defaultShippingMethod String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("shipping_settings")
}

// Singleton row (the app always reads/writes id 1) holding every
// store-wide setting exposed by the admin Settings page, except shipping
// itself which stays in ShippingSetting above.
model SystemSettings {
  id Int @id @default(autoincrement())

  // General / store identity
  siteName        String  @default("E-commerce Timor-Leste")
  siteDescription String  @default("Online marketplace for Timor-Leste") @db.Text
  // Branding assets — Cloudinary URLs, uploaded via
  // POST /admin/settings/upload-logo and /upload-favicon. Null means "use
  // the built-in text logo / default favicon.ico" rather than a broken
  // image, so both are optional.
  logoUrl         String?
  faviconUrl      String?
  contactEmail    String  @default("support@ecommercetimor.com")
  contactPhone    String @default("+670 1234 5678")
  address         String @default("Dili, Timor-Leste") @db.Text
  currency        String @default("USD")
  taxRate         Float  @default(8)
  serviceFee      Float  @default(4.5)

  // Seller finance. defaultCommissionRate is a live setting — it only
  // affects orders paid AFTER a change. Orders already paid keep the rate
  // snapshotted onto them at payment-confirm time (Order.commissionRate),
  // so changing this here never rewrites historical earnings.
  defaultCommissionRate Float @default(10)
  minimumPayoutAmount   Float @default(0)
  // Hours a BANK_TRANSFER payment stays PENDING with no receipt uploaded
  // before PaymentExpiryJob auto-expires it and releases reserved stock.
  paymentExpiryHours    Float @default(48)

  // System toggles
  maintenanceMode            Boolean @default(false)
  maintenanceMessage         String  @default("We are currently under maintenance. Please check back later.") @db.Text
  registrationOpen           Boolean @default(true)
  sellerVerificationRequired Boolean @default(true)
  enableReviews              Boolean @default(true)
  requireReviewApproval      Boolean @default(true)
  maxProductImages           Int     @default(5)

  // Payment methods
  enableCOD                Boolean @default(true)
  enableBankTransfer       Boolean @default(true)
  minCODOrderAmount        Float   @default(0)
  maxCODOrderAmount        Float   @default(1000)
  autoConfirmBankTransfer  Boolean @default(false)

  // Referral program. rewardAmount changes here only affect referrals
  // created AFTER the change — each Referral snapshots the amount it
  // actually paid out at the time (welcomeCreditAmount/rewardAmount on
  // that model), same reasoning as Order.commissionRate above.
  referralProgramEnabled Boolean @default(true)
  referralWelcomeCredit  Float   @default(3)
  referralRewardAmount   Float   @default(5)

  bankName                 String?
  bankAccountName          String?
  bankAccountNumber        String?
  bankIBAN                 String?
  bankSWIFT                String?
  bankTransferInstructions String? @db.Text

  // Outbound email (SMTP)
  smtpHost                String?
  smtpPort                Int     @default(587)
  smtpUser                String?
  smtpPassword            String?
  smtpSecure              Boolean @default(false)
  fromEmail               String  @default("noreply@ecommercetimor.com")
  fromName                String  @default("E-commerce Timor-Leste")
  sendOrderConfirmation   Boolean @default(true)
  sendPaymentConfirmation Boolean @default(true)
  sendShippingUpdate      Boolean @default(true)
  sendWelcomeEmail        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Review {
  id              Int       @id @default(autoincrement())
  productId       Int
  userId          Int
  rating          Int
  title           String?
  comment         String
  images          Json      @default("[]")
  isApproved      Boolean   @default(false)
  helpfulCount    Int       @default(0)
  sellerReply     String?
  sellerReplyAt   DateTime?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id])
  helpfulVotes  ReviewHelpful[]
  reviewReports ReviewReport[]

  // One review per customer per product. The service layer already checks
  // this before insert, but that check-then-write isn't atomic — two
  // concurrent submits from the same user could both pass it. This is the
  // actual guarantee; the app-level check just gives a friendlier error.
  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model ReviewHelpful {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  userId    Int
  createdAt DateTime @default(now())

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
  @@map("review_helpful")
}

model ReviewReport {
  id         Int       @id @default(autoincrement())
  reviewId   Int
  userId     Int
  reason     String
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy Int?

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@map("review_reports")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  // Specific event name (e.g. "PAYMENT_RECEIPT_UPLOADED", "ORDER_CREATED") —
  // see NotificationEvent in notifications.constants.ts for the closed set.
  // `category` is the coarser domain grouping used for filtering/tabs.
  type      String
  category  NotificationCategory @default(SYSTEM)
  priority  NotificationPriority @default(INFO)
  // Polymorphic reference to the resource this notification is about (e.g.
  // entityType="PAYMENT", entityId=42) so the admin UI can route a click
  // straight to it. No FK — entityType varies per row, and the referenced
  // row may later be deleted; the UI handles a missing target gracefully
  // instead of relying on a DB constraint.
  entityType String?
  entityId   Int?
  // Who/what triggered this notification (e.g. the admin who approved a
  // payment, the customer who uploaded a receipt). Null for system-generated
  // events (e.g. a stock-threshold cron). No FK for the same reason as
  // entityId — an actor's account outliving or outlasting the notification
  // must never cascade-delete it.
  actorId   Int?
  isRead    Boolean   @default(false)
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([category])
  @@index([entityType, entityId])
  @@map("notifications")
}

// One row per subscribed browser/device (Web Push API — PushSubscription
// object from `registration.pushManager.subscribe()`), not per user — the
// same account can have several (phone + desktop). Every Notification
// created via NotificationsService.sendNotification also best-effort sends
// a push to all of a user's rows here (see PushNotificationsService); this
// table is purely delivery plumbing, never read/shown directly to anyone.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique @db.VarChar(512)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================================
// Homepage Section Engine
// ============================================================================
// Replaces one-off hardcoded homepage sections (Featured/New Arrivals/
// Popular/Local were each a separate frontend component + backend endpoint)
// with a single configurable engine: a HomepageSection picks a RULE, the
// rule resolves a product list server-side, and the frontend renders every
// section through one generic renderer regardless of rule. Only rules with
// real, existing data behind them are implemented (see HomepageSectionRule
// doc-comment below) — no per-section boolean flags on Product.
enum HomepageSectionRule {
  MANUAL // admin-curated list via HomepageSectionProduct, ordered by position
  NEWEST // isActive + stock>0, orderBy createdAt desc
  POPULAR // isActive + stock>0, ranked by wishlist + approved review count
  BEST_SELLING // isActive, ranked by delivered OrderItem count
  LOCAL // isActive + stock>0 within a specific category (config.categoryId) — same mechanism as CATEGORY, kept as a distinct rule for merchandising clarity since "local products" is a real, named customer-facing concept, not a generic category browse
  ON_SALE // isActive + stock>0 + comparePrice > price
  LIMITED_STOCK // isActive + 0 < stock <= config.stockThreshold (default 5)
  CATEGORY // isActive + stock>0 within config.categoryId
  FLASH_SALE // isActive + stock>0 with a currently-ACTIVE seller Promotion (see Promotion model), ordered by promotion.endAt ascending — soonest-ending first. The resolved section response carries an extra `endsAt` (earliest endAt among its products) for the frontend's countdown timer; no config needed, unlike ON_SALE this can never include a product whose "discount" is just a static comparePrice.
}

model HomepageSection {
  id           Int                 @id @default(autoincrement())
  name         String // internal/admin-facing label, e.g. "Featured Products"
  title        String // customer-facing heading
  subtitle     String?
  type         String              @default("PRODUCT_COLLECTION") // future-proofed for BANNER/CATEGORY/CAMPAIGN non-product sections; only PRODUCT_COLLECTION exists today
  rule         HomepageSectionRule
  config       Json                @default("{}") // rule-specific params: {categoryId} for LOCAL/CATEGORY, {stockThreshold} for LIMITED_STOCK
  sort         String?             // optional override of a rule's default ordering: newest|oldest|price_asc|price_desc|popularity|sales — ignored by MANUAL (always position-ordered)
  productLimit Int                 @default(8)
  displayOrder Int                 @default(0)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  products HomepageSectionProduct[]

  @@index([isActive, displayOrder])
  @@map("homepage_sections")
}

// Manual product curation for MANUAL-rule sections. Deliberately generic
// (not tied to "featured" specifically) so any section, not just one
// hardcoded concept, can have an admin-picked, positioned product list.
model HomepageSectionProduct {
  id        Int      @id @default(autoincrement())
  sectionId Int
  productId Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  section HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@index([sectionId, position])
  @@map("homepage_section_products")
}

// Homepage hero/banner slides — admin-managed, image-led promotional
// content (not tied to a specific product like HomepageSection is).
// desktopImage is required; mobileImage is optional and falls back to
// desktopImage on the storefront if unset. startDate/endDate are both
// optional — null means "no bound on that side", so a banner can be
// scheduled to start later, end at a point, both, or neither (always on
// while isActive).
// Pure image banners — the image itself is the full designed graphic
// (text, pricing, branding all baked in by whoever designs it), so there's
// no separate title/price/badge overlay to manage here. `title` is an
// admin-only label for identifying banners in the list — it is never
// rendered on the storefront.
model HeroBanner {
  id           Int       @id @default(autoincrement())
  badge        String?
  title        String
  subtitle     String?
  buttonText   String?
  buttonUrl    String?
  desktopImage String
  mobileImage  String?
  position     Int       @default(0)
  isActive     Boolean   @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, position])
  @@map("hero_banners")
}

// ============================================================================
// Website Health / Audit Dashboard
// ============================================================================
// Performance/Accessibility/BestPractices/SEO scores come from Google's
// PageSpeed Insights API (Google runs the real Lighthouse audit on their own
// infrastructure — never a self-hosted headless browser on this box, which
// only has 2 CPU cores and serves live customer traffic). Security scores
// come from this server's own lightweight header/cookie checks against the
// single configured, allow-listed base URL (see ssrf-guard.util.ts) — never
// an arbitrary admin-supplied URL. See WebsiteHealthService's doc-comment
// for the full architecture.

enum AuditStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum IssueCategory {
  PERFORMANCE
  ACCESSIBILITY
  BEST_PRACTICES
  SEO
  SECURITY
}

enum IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum MetricRating {
  GOOD
  NEEDS_IMPROVEMENT
  POOR
}

model WebsiteAudit {
  id          Int         @id @default(autoincrement())
  status      AuditStatus @default(QUEUED)
  startedAt   DateTime?
  completedAt DateTime?
  // Nullable: a system/scheduled trigger (not built in this phase, but the
  // column exists so it doesn't need a migration later) has no admin user.
  triggeredBy Int?

  overallScore       Float?
  performanceScore   Float?
  accessibilityScore Float?
  bestPracticesScore Float?
  seoScore           Float?
  securityScore      Float?

  // Recorded test conditions — shown on every report so a score is never
  // presented without the context it was measured under (spec §57).
  device  String @default("mobile")
  baseUrl String

  // Both bumped only when the underlying audit logic/scoring formula
  // actually changes, so a historical report keeps rendering exactly what
  // it showed when it was generated even after later audits use a newer
  // version (spec §41/§42) — never recomputed retroactively.
  auditEngineVersion String @default("1.0")
  scoreVersion       String @default("1.0")

  errorMessage String? @db.Text

  targets AuditTarget[]
  issues  AuditIssue[]
  metrics AuditMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("website_audits")
}

// One row per page audited within a WebsiteAudit run (homepage, /products,
// a representative product detail page, etc. — see AUDIT_TARGET_TEMPLATES).
model AuditTarget {
  id      Int    @id @default(autoincrement())
  auditId Int
  audit   WebsiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  url        String
  route      String
  pageType   String
  statusCode Int?
  durationMs Int?

  performanceScore   Float?
  accessibilityScore Float?
  bestPracticesScore Float?
  seoScore           Float?

  issues  AuditIssue[]
  metrics AuditMetric[]

  createdAt DateTime @default(now())

  @@index([auditId])
  @@index([url])
  @@map("audit_targets")
}

model AuditIssue {
  id      Int    @id @default(autoincrement())
  auditId Int
  audit   WebsiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  // Null for site-wide findings (e.g. a security header check that isn't
  // tied to one specific page).
  targetId Int?
  target   AuditTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  category IssueCategory
  // Stable identifier for the underlying check (a Lighthouse audit id like
  // "uses-responsive-images", or one of this system's own security rule
  // ids like "security.hsts-missing") — lets the same finding be recognized
  // as "the same issue" across separate audit runs.
  ruleId   String
  severity IssueSeverity
  status   IssueStatus @default(OPEN)

  title          String
  description    String  @db.Text
  impact         String?
  recommendation String  @db.Text
  affectedUrl    String?
  selector       String?
  // Sanitized (HTML-escaped, length-capped) before storage — this is
  // rendered back to the admin as plain text, never dangerouslySetInnerHTML,
  // but it is escaped at write time too since raw scanner/Lighthouse output
  // is untrusted input (spec §49).
  evidence          String? @db.Text
  documentationUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditId])
  @@index([category])
  @@index([severity])
  @@index([status])
  @@map("audit_issues")
}

model AuditMetric {
  id      Int    @id @default(autoincrement())
  auditId Int
  audit   WebsiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  targetId Int?
  target   AuditTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  category   IssueCategory
  // e.g. "LCP", "CLS", "TBT", "FCP", "SpeedIndex", "TTFB".
  metricName String
  value      Float
  unit       String
  threshold  Float?
  rating     MetricRating?

  createdAt DateTime @default(now())

  @@index([auditId])
  @@index([targetId])
  @@map("audit_metrics")
}

// Singleton settings row (id is always 1) — configured target domain,
// category weights, scope, and retention. Kept as its own table (rather
// than reusing the generic app Settings model, if one exists) so its
// validation (weights summing to 100, baseUrl allow-list) stays scoped to
// this feature.
model WebsiteHealthSettings {
  id Int @id @default(1)

  // The ONLY domain audits are ever allowed to target — see
  // ssrf-guard.util.ts. Changing this is itself a sensitive, logged action
  // (spec §38), never accepted as a per-request override from the client.
  baseUrl String

  // Percent weights, must sum to 100 — enforced in
  // update-settings.dto.ts / the service layer, not just the UI.
  weightPerformance    Int @default(25)
  weightAccessibility  Int @default(15)
  weightBestPractices  Int @default(15)
  weightSeo            Int @default(20)
  weightSecurity       Int @default(25)

  // Which route templates are included by default when an admin starts a
  // new audit without customizing scope (see AUDIT_TARGET_TEMPLATES ids).
  defaultScope Json @default("[\"home\",\"products\",\"product-detail\",\"search\",\"cart\",\"local-products\"]")

  timeoutSeconds     Int @default(60)
  retentionDays      Int @default(90)

  updatedBy Int?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("website_health_settings")
}
