# Database
DATABASE_URL="mysql://username:password@localhost:3306/ecommerce_timor"

# Redis
REDIS_ENABLED=true
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email (Mailtrap for development)
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USER="your-mailtrap-user"
MAIL_PASS="your-mailtrap-password"
MAIL_FROM="noreply@ecommercetimor.com"

# App
PORT=3001
NODE_ENV="development"
APP_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
# Admin panel origin, for the CORS allow-list
ADMIN_URL="http://localhost:3002"
# Optional: only needed in production if the API and both frontends share a
# parent domain (e.g. ".example.com") and you want the auth cookie visible
# to all of them. Leave unset for local development.
COOKIE_DOMAIN=
# Optional: overrides whether the auth cookie is marked Secure, which
# otherwise defaults to NODE_ENV === 'production'. Only set this to
# "false" if you're temporarily serving production over plain HTTP (no
# domain/SSL yet) — a Secure cookie is silently dropped by the browser
# over http://, which breaks login. Leave unset once HTTPS is in front
# of the API.
COOKIE_SECURE=

# Admin
ADMIN_EMAIL="admin@ecommercetimor.com"
ADMIN_PASSWORD="Admin@123"

# AI Search (Anthropic Claude) — powers the natural-language "Search AI" bar.
# Get a key at https://console.anthropic.com. Leave unset to disable AI search
# (the endpoint returns a clear error instead of crashing).
ANTHROPIC_API_KEY=

# Google Sign-In (via Firebase Admin SDK) — powers POST /auth/google.
# From Firebase Console → Project Settings → Service Accounts → Generate
# new private key (downloads a JSON file with these 3 fields). Leave unset
# to disable Google sign-in (the endpoint returns a clear error instead of
# crashing). FIREBASE_PRIVATE_KEY must keep its \n sequences literal —
# wrap the whole value in double quotes exactly as the downloaded JSON has it.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
