# Compose-level MySQL credentials for docker-compose.prod.yml.
# Copy this to `.env` on the VPS (never commit the real file) and fill in
# strong passwords. These MUST match the credentials used in the
# DATABASE_URL inside backend-services/.env.production.

MYSQL_ROOT_PASSWORD=change-me-strong-root-password
MYSQL_DATABASE=ecommerce_timor
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=change-me-strong-user-password
