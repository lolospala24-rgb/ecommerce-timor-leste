# Local environment variables for admin-panel
# Copy this file to .env.local and set your real values before running the app.

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Optional: set to "false" only if this deployment is temporarily served
# over plain HTTP with no domain/SSL yet — a Secure session_role cookie is
# silently dropped by the browser over http://, which breaks login (the
# backend session succeeds but middleware.ts never sees session_role and
# redirects back to /login). Leave unset once HTTPS is in front of this app.
NEXT_PUBLIC_COOKIE_SECURE=
