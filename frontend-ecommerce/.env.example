# ============================================
# API Configuration
# ============================================
PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002

# ============================================
# Maps (address pin-drop picker)
# ============================================
# Google Maps — required for GoogleMapPicker (checkout's "pick location on
# map" address helper). Get a key at https://console.cloud.google.com/
# (enable the Maps JavaScript API and Geocoding API) and restrict it to
# this site's domain via HTTP referrer restrictions. Never hardcode a real
# key as a fallback in source; the picker fails gracefully with a clear
# error if this is unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ============================================
# Firebase (Google Sign-In) — from Firebase Console > Project Settings >
# General > Your apps > Web app > SDK setup and configuration > Config.
# These are public by design (safe to ship in client bundles). Leave unset
# to hide the "Continue with Google" button entirely.
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================
# Cloudinary (for image uploads)
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ============================================
# Analytics & Monitoring
# ============================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_GUEST_CHECKOUT=true
NEXT_PUBLIC_ENABLE_WISHLIST=true
NEXT_PUBLIC_ENABLE_REVIEWS=true

# ============================================
# SEO & Metadata
# ============================================
NEXT_PUBLIC_SITE_NAME=E-commerce Timor-Leste
NEXT_PUBLIC_SITE_DESCRIPTION=Platform kompras online ba Timor-Leste
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ============================================
# Payment Methods (Timor-Leste specific)
# ============================================
NEXT_PUBLIC_ENABLE_COD=true
NEXT_PUBLIC_ENABLE_BANK_TRANSFER=true
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=50

# ============================================
# Currency & Locale
# ============================================
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_CURRENCY_SYSTEM=$
NEXT_PUBLIC_LOCALE=en-US
NEXT_PUBLIC_TIMEZONE=Asia/Dili

# ============================================
# Contact Information
# ============================================
NEXT_PUBLIC_CONTACT_EMAIL=support@ecommercetimor.com
NEXT_PUBLIC_CONTACT_PHONE=+670 1234 5678
NEXT_PUBLIC_CONTACT_ADDRESS=Dili, Timor-Leste

# ============================================
# Social Media Links
# ============================================
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/ecommercetimor
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/ecommercetimor
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/ecommercetimor

# ============================================
# Cache & Performance
# ============================================
NEXT_PUBLIC_CACHE_TTL=300
NEXT_PUBLIC_STALE_TIME=60000

# ============================================
# Debug & Development
# ============================================
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_SHOW_DEV_TOOLS=false
